# ─────────────────────────────────────────────────────────────
# Deepwork / StudySync Application Environment Configuration
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pmmziei.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_long_random_secret_in_production_32chars

# ─────────────────────────────────────────────────────────────
# LiveKit Cloud or Self-Hosted Configuration
# ─────────────────────────────────────────────────────────────
# LiveKit Server URL (LiveKit Cloud or Self-Hosted instance)
# Format for Cloud: wss://<project-subdomain>.livekit.cloud
# Format for Local/Self-hosted: ws://localhost:7880 or wss://livekit.yourdomain.com
LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key & Secret (From LiveKit Cloud Console Settings -> Keys)
# NEVER expose LIVEKIT_API_SECRET to the client-side code or public repositories!
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional Google OAuth Client ID for Google Calendar Integration
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Server Port (for standalone Express backend)
PORT=5001
