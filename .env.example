# ─────────────────────────────────────────────────────────────
# Deepwork / StudySync Application Environment Configuration
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pmmziei.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Required for production calls when the web app is hosted on Vercel.
# Deploy the Node signaling server (for example with render.yaml), then set this
# to its public secure WebSocket URL before building/deploying the web app.
VITE_COLLAB_WS_URL=wss://your-domain.example/api/collab-socket

# Optional TURN relay for restrictive NATs/firewalls. Configure TURN credentials
# with your provider; VITE_ values are delivered to browsers at build time.
VITE_TURN_URLS=turn:your-turn-host.example:3478,turns:your-turn-host.example:5349
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional Google OAuth Client ID for Google Calendar Integration
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Server Port (for the WebRTC signaling server)
PORT=5001
